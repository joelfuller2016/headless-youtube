{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joelfuller2016/headless-youtube/examples/script-schema.json",
  "title": "Short video script",
  "description": "The single JSON object that flows through the pipeline from script generation to publishing. Every stage reads it and writes back into it; nothing else carries state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "pillar",
    "series",
    "idea",
    "original_angle",
    "title",
    "hook",
    "scenes",
    "close",
    "description",
    "hashtags",
    "safety",
    "targets"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable job id, e.g. 2026-10-08-a-prayer-for-a-new-job. Used as the folder name under output/.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$"
    },
    "pillar": {
      "type": "string",
      "enum": [
        "hope",
        "prayer",
        "mental-health",
        "job-career",
        "encouragement",
        "happiness"
      ],
      "description": "Content pillar. Drives the rotation, the tone rules, and the safety level."
    },
    "series": {
      "type": "string",
      "enum": [
        "a-prayer-for",
        "to-the-person-who",
        "one-verse-one-minute",
        "monday-reset",
        "when-your-mind-says",
        "small-joys",
        "permission-slip",
        "interview-day",
        "grief-is",
        "night-prayer",
        "you-are-not-behind",
        "thank-you-for",
        "breathe-with-me",
        "sixty-second-story",
        "pray-with-me",
        "younger-self"
      ],
      "description": "One of the series ids in docs/CONTENT_STRATEGY.md section 3."
    },
    "idea": {
      "type": "string",
      "description": "The raw prompt that started this job, exactly as typed or as generated by the self-feeding scheduler."
    },
    "original_angle": {
      "type": "string",
      "maxLength": 200,
      "description": "The one concrete perspective this video takes that recent videos did not. Required so no two videos are the same template with new nouns."
    },
    "source": {
      "type": "string",
      "enum": [
        "cli",
        "email",
        "github-issue",
        "manual",
        "relay",
        "self-feed",
        "sheet",
        "telegram"
      ],
      "description": "Where the idea came from (the origin, even though every source opens a GitHub issue)."
    },
    "title": {
      "type": "string",
      "maxLength": 70,
      "description": "Platform title. YouTube allows 100 characters."
    },
    "hook": {
      "type": "string",
      "description": "The first spoken line. Must stand alone and earn the next two seconds."
    },
    "scenes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "text",
          "visual"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "description": "Spoken words for this scene. One to three sentences."
          },
          "visual": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "prompt"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "brand-card",
                  "stock-clip",
                  "ai-image",
                  "ai-video"
                ],
                "description": "Which rung of the visual ladder renders this scene. The pipeline may downgrade (ai-video -> ai-image -> stock-clip -> brand-card) when a provider fails or the budget is spent."
              },
              "prompt": {
                "type": "string",
                "description": "Search terms for stock, or the image/video generation prompt. Never contains text to be rendered inside the image."
              },
              "mood": {
                "type": "string",
                "description": "Short mood tag used to pick colour and music, e.g. calm-dawn, warm-kitchen, rain-window."
              },
              "asset": {
                "type": "object",
                "additionalProperties": false,
                "description": "Written by the visuals stage: provenance for the asset actually used.",
                "properties": {
                  "provider": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  },
                  "source_url": {
                    "type": "string"
                  },
                  "licence": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "photoreal": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          "caption_emphasis": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Words to highlight in the on-screen captions."
          },
          "duration_hint_s": {
            "type": "number",
            "minimum": 2,
            "maximum": 15
          }
        }
      }
    },
    "close": {
      "type": "string",
      "description": "The last spoken line, spoken as the final scene over the end-card visual. A blessing, a question, or a gentle invitation to come back tomorrow (on a heavy script, a line that points to help). Never a hard sell."
    },
    "description": {
      "type": "string",
      "maxLength": 5000,
      "description": "Platform description. The metadata stage appends crisis resources when safety.crisis_resources is true."
    },
    "hashtags": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "string",
        "pattern": "^#[a-z0-9_]+$"
      },
      "contains": {
        "const": "#shorts"
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mood": {
          "type": "string"
        },
        "track_id": {
          "type": "string",
          "description": "Filled in by the render stage from the licensed music library."
        },
        "licence": {
          "type": "string",
          "description": "Licence summary or URL for the bed, stored with the job for disputes."
        }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string"
        },
        "voice_id": {
          "type": "string"
        },
        "pace": {
          "type": "string",
          "enum": [
            "slow",
            "normal"
          ]
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sensitivity",
        "crisis_resources",
        "quotes"
      ],
      "properties": {
        "sensitivity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "description": "high = suicide, self-harm, eating disorders, abuse, addiction, acute grief; triggers stricter language rules, crisis resources and owner approval (D-019). medium = anxiety, depression, burnout, loneliness without a heavy topic; gentler pace and the footer line, no approval hold. low = everything else."
        },
        "crisis_resources": {
          "type": "boolean"
        },
        "quotes": {
          "type": "array",
          "description": "Every quoted line and where it comes from. Scripture must name translation and reference. Anything that cannot be sourced is rewritten as an original line.",
          "items": {
            "type": "object",
            "required": [
              "attribution",
              "status"
            ],
            "properties": {
              "text": {
                "type": "string",
                "description": "The words as spoken; omitted for a verse token, which the pipeline fills from the translation file."
              },
              "attribution": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "public-domain",
                  "licensed-within-limits",
                  "original",
                  "unverified"
                ]
              },
              "reference": {
                "type": "string",
                "description": "Book, chapter and verse for scripture, matching a {{verse:...}} token in a scene."
              },
              "translation": {
                "type": "string",
                "enum": [
                  "WEB",
                  "BSB",
                  "KJV",
                  "ESV"
                ],
                "description": "Set by the pipeline when it inserts the verse; WEB or BSB by default, KJV when the series asks, ESV only within its gratis terms."
              }
            }
          }
        },
        "judge_verdict": {
          "type": "string",
          "enum": [
            "pending",
            "pass",
            "revise",
            "reject"
          ]
        },
        "judge_notes": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "sensitivity": {
            "const": "high"
          }
        }
      },
      "then": {
        "properties": {
          "crisis_resources": {
            "const": true
          }
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_s",
        "words"
      ],
      "properties": {
        "duration_s": {
          "type": "integer",
          "minimum": 45,
          "maximum": 60
        },
        "words": {
          "type": "integer",
          "minimum": 100,
          "maximum": 160
        }
      },
      "description": "Per-job band from the series duration and the measured pace; the deterministic gate accepts words within 10 of targets.words."
    },
    "render": {
      "type": "object",
      "description": "Written by the render stage.",
      "properties": {
        "tier": {
          "type": "string",
          "enum": [
            "A-brand-card",
            "B-stock-loop",
            "C-ai-image",
            "D-ai-video",
            "E-hybrid",
            "F-ai-presenter"
          ]
        },
        "video_path": {
          "type": "string"
        },
        "thumbnail_path": {
          "type": "string"
        },
        "actual_duration_s": {
          "type": "number"
        },
        "cost_usd": {
          "type": "number"
        },
        "synthetic_media": {
          "type": "boolean",
          "description": "Set by the visuals stage when any scene is generated (tiers C, D, F, or E with a generated hook) or the video is mostly generated music; the metadata stage sets every platform's AI flag from it (D-020)."
        }
      }
    },
    "publish": {
      "type": "object",
      "description": "Written by the publish stage, one entry per platform.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "scheduled",
              "published",
              "failed",
              "skipped"
            ]
          },
          "remote_id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "scheduled_for": {
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "type": "string"
          }
        }
      }
    },
    "why_today": {
      "type": "string",
      "maxLength": 200,
      "description": "The idea generator's one-sentence reason; copied into the issue body."
    }
  }
}
